{
  "version": 1,
  "idle": {
    "screensaver": 0,
    "lock": 600
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.indicators" },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "right": [
        { "id": "omarchy.tray" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.wezfurlong.wezterm",
      "io.github.lgse.Strata",
      "org.gnome.Nautilus",
      "firefox",
      "dev.zed.Zed"
    ]
  },
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.agents",
    "omarchy.reminders",
    "omarchy.dev-gallery",
    "omarchy.media"
  ],
  "plugins": []
}
