{
  "model": "opus",
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ -f \"$f\" ] && bash \"$f\" session || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "coderabbit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "superpowers@claude-plugins-official": true,
    "aws-core@claude-plugins-official": false,
    "terraform-skill@antonbabenko": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "antonbabenko": {
      "source": {
        "source": "github",
        "repo": "antonbabenko/agent-plugins"
      }
    }
  },
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": false,
  "inputNeededNotifEnabled": true
}
