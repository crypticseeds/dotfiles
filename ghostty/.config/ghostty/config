# Ghostty on the Fedora niri desktop (docs/niri.md).
# Colors follow Noctalia: its ghostty template writes ~/.config/ghostty/themes/noctalia
# (generated, not in the repo) and reloads running terminals on every palette change.
# Keep this line exactly as is, or Noctalia rewrites this file to put it back.
theme = noctalia

font-family = JetBrainsMono Nerd Font
font-size = 16
cursor-style = underline

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
# niri draws the border; drop GTK's header bar (tabs still show when there are several).
gtk-titlebar = false

confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
selection-clear-on-copy = true

# Shell integration's "cursor" feature forces a bar cursor at the prompt,
# overriding cursor-style. Disable it so the underline sticks.
shell-integration-features = no-cursor

# Splits are handled by herdr (bound to cmd+d / cmd+shift+d / cmd+w in its config).
# Unbind them here so Ghostty passes the keys through instead of splitting/closing.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+w=unbind

# niri's Cmd+C / Cmd+V send Ctrl+Shift+C / Ctrl+Shift+V to terminals (docs/niri.md).
# Fallback in case the still-held Cmd reaches Ghostty as Super.
keybind = super+ctrl+shift+c=copy_to_clipboard
keybind = super+ctrl+shift+v=paste_from_clipboard
