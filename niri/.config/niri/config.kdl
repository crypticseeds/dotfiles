// niri on the Fedora VM (VMware Fusion). Wiki: https://niri-wm.github.io/niri/
// Shell: Noctalia (~/.config/noctalia). Terminal: Ghostty. See docs/niri.md in the
// dotfiles repo for the keymap and the workspace workflow.
//
// Colors are not set here. Noctalia renders the active palette into
// ~/.config/niri/noctalia.kdl (generated, not in the repo), included at the end so it
// wins. The include is optional: the first login before Noctalia ran still loads.

input {
    keyboard {
        // Empty xkb: niri reads the layout from org.freedesktop.locale1 (localectl).
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

// The VM's virtual display (vmwgfx). Pinned to the resolution GNOME uses, so niri does
// not pick the 4096x2160 mode the virtual GPU also advertises.
output "Virtual-1" {
    mode "1920x1080"
    scale 1
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}

environment {
    // Apps that look up a terminal (Noctalia's launcher for Terminal=true entries).
    TERMINAL "ghostty"
}

layout {
    gaps 8
    center-focused-column "never"

    // Mod+R cycles these. 1/2 + 1/2 is the side-by-side split.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // Clean look: a thin border on every window (colored on the focused one), no ring,
    // no shadows. Colors come from noctalia.kdl.
    focus-ring {
        off
    }
    border {
        width 2
    }

    // Transparent so Noctalia's wallpaper (placed in the backdrop below) shows through
    // and stays still while workspaces scroll.
    background-color "transparent"
}

// Workspaces 1-3 always exist and keep their names in the bar; Mod+4.. are dynamic.
workspace "term"
workspace "code"
workspace "web"

overview {
    workspace-shadow {
        off
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "noctalia"
// Text clipboard sync between X11 (incl. VMware's Mac copy/paste helper) and Wayland
// apps; xwayland-satellite skips it for windowless X11 clients. See the script header.
spawn-sh-at-startup "exec python3 ~/.config/niri/scripts/clipboard-bridge.py"

debug {
    // vmwgfx's hardware cursor plane leaves the pointer invisible or offset; draw it in
    // software instead. Remove on real hardware.
    disable-cursor-plane
    // Lets Noctalia notifications and its launcher focus the windows they activate.
    honor-xdg-activation-with-invalid-serial
}

// ---------------------------------------------------------------------------
// Noctalia surfaces
// ---------------------------------------------------------------------------

// Stationary wallpaper, also visible behind the overview.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// No blur anywhere: the virtual GPU pays for every pass. Noctalia requests blur on
// its own, so it has to be refused explicitly.
layer-rule {
    match namespace="^noctalia-"
    background-effect {
        blur false
    }
}

// ---------------------------------------------------------------------------
// Window rules
// ---------------------------------------------------------------------------

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// One app per workspace by default: Zed and Firefox open on their own workspace,
// filling it. Mod+F un-maximizes back to half width for a side-by-side split.
// Ghostty has no rule: a terminal opens wherever you are.
window-rule {
    match app-id=r#"^dev\.zed\.Zed"#
    open-on-workspace "code"
    open-maximized true
}
window-rule {
    match app-id=r#"firefox$"#
    open-on-workspace "web"
    open-maximized true
}

// File managers float, centered, so they never reflow the tiled columns.
window-rule {
    match app-id=r#"^io\.github\.lgse\.Strata$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}

// Herdr GUI fills its workspace like Zed and Firefox; Mod+F toggles it.
window-rule {
    match app-id=r#"^so\.pen\.herdr-gpui$"#
    open-maximized true
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// ---------------------------------------------------------------------------
// Keys. Mod is Super (the Mac's Cmd key in Fusion). Mod+Shift+/ lists them.
// ---------------------------------------------------------------------------

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal: Ghostty" { spawn "ghostty"; }
    Mod+T hotkey-overlay-title=null { spawn "ghostty"; }
    Mod+B hotkey-overlay-title="Browser: Firefox" { spawn "firefox"; }
    // Zed and Strata install per user into ~/.local/bin, which niri's PATH lacks (the
    // login session's PATH is /usr/local/bin:/usr/bin), so add it for these two only.
    Mod+Z hotkey-overlay-title="Editor: Zed" { spawn-sh "PATH=$HOME/.local/bin:$PATH exec zed"; }
    Mod+E hotkey-overlay-title="Files: Strata" { spawn-sh "PATH=$HOME/.local/bin:$PATH exec strata"; }
    // Herdr GUI: opened on demand only, nothing autostarts it.
    Mod+G hotkey-overlay-title="Agents: Herdr" { spawn "herdr-gpui"; }

    // Noctalia
    Mod+Space hotkey-overlay-title="App launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+Comma hotkey-overlay-title="Noctalia settings (theme, bar, wallpaper)" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Shift+N hotkey-overlay-title="Do not disturb" { spawn "noctalia" "msg" "notification-dnd-toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E hotkey-overlay-title="Session menu (log out, reboot, power off)" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Ctrl+Alt+Delete { quit; }

    // Screenshots. Mac keyboards have no Print key, so each has a Mod chord too.
    // Region: select, draw on it, then Ctrl+C copies / Ctrl+S saves to ~/Pictures/Screenshots.
    Mod+Shift+S hotkey-overlay-title="Screenshot region + annotate" { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Ctrl+S hotkey-overlay-title="Screenshot screen" { screenshot-screen; }
    Mod+Alt+S hotkey-overlay-title="Screenshot window" { screenshot-window; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Volume (Noctalia shows the OSD).
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // Alt+Tab is niri's built-in recent-windows switcher (live previews); no bind needed.

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    // H/L: columns. J/K: workspaces (stacked windows in a column: Mod+Up/Down).
    Mod+H     { focus-column-left; }
    Mod+J     { focus-workspace-down; }
    Mod+K     { focus-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-column-to-workspace-down; }
    Mod+Ctrl+K     { move-column-to-workspace-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+J         { move-workspace-down; }
    Mod+Shift+K         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // 1 term, 2 code, 3 web, then dynamic workspaces.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Tab { focus-workspace-previous; }

    // Stack windows in one column, or pull them out again.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Sizing. Side by side: Mod+F the maximized window, or Mod+R each to 1/2.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Alt+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Mac-style copy/cut/paste: the script types the focused app's own keys (Ctrl+C/X/V,
    // Ctrl+Shift+C/V in terminals) through wtype. See the script header.
    Mod+C repeat=false hotkey-overlay-title="Copy" { spawn-sh "exec ~/.config/niri/scripts/clipboard-keys.sh copy"; }
    Mod+X repeat=false hotkey-overlay-title="Cut" { spawn-sh "exec ~/.config/niri/scripts/clipboard-keys.sh cut"; }
    Mod+V repeat=false hotkey-overlay-title="Paste" { spawn-sh "exec ~/.config/niri/scripts/clipboard-keys.sh paste"; }
    Mod+A repeat=false hotkey-overlay-title="Select all" { spawn-sh "exec ~/.config/niri/scripts/clipboard-keys.sh select"; }

    // Floating: Mod+Alt+V floats/tiles the focused window, Mod+Ctrl+V jumps between layers.
    Mod+Alt+V  { toggle-window-floating; }
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Escape hatch if an app grabs the keyboard shortcuts.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}

include optional=true "noctalia.kdl"
