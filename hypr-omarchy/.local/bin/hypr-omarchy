#!/bin/sh
# Start the Omarchy-style Hyprland session from a TTY (the regular one stays `start-hyprland`).
# Uses ~/.config/hypr-omarchy/hyprland.lua and the pinned Omarchy checkout from `make hypr-omarchy`.
# uwsm runs it as a systemd session; Omarchy launches every app through `uwsm-app`.
set -eu
export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
if [ ! -f "$OMARCHY_PATH/default/hypr/bootstrap.lua" ]; then
  echo "hypr-omarchy: no Omarchy checkout at $OMARCHY_PATH; run 'make hypr-omarchy' in ~/dotfiles" >&2
  exit 1
fi
exec uwsm start -D Hyprland -N "Hyprland (Omarchy)" -- \
  start-hyprland -- --config "$HOME/.config/hypr-omarchy/hyprland.lua"
