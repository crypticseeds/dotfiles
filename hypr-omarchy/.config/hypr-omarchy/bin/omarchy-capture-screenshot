#!/bin/bash
# Replaces Omarchy's screenshot command (it needs omasnap, an Omarchy-only package)
# with grim + slurp. Same arguments: [smart|region|windows|fullscreen] [copy|save].
# Default: select a region, copy it and save it to ~/Pictures/Screenshots.
set -u

mode=region copy=1 save=1
for arg in "$@"; do
  case "$arg" in
    smart|region|windows) mode=region ;;
    fullscreen) mode=fullscreen ;;
    copy) copy=1 save=0 ;;
    save) copy=0 save=1 ;;
  esac
done

if [[ $mode == region ]]; then
  geometry=$(slurp -d) || exit 0 # Escape cancels
  args=(-g "$geometry")
else
  output=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')
  args=(-o "$output")
fi

dir="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}"
file="$dir/screenshot-$(date +%Y%m%d-%H%M%S).png"
mkdir -p "$dir"
grim "${args[@]}" "$file" || exit 1

(( copy )) && wl-copy --type image/png <"$file"
if (( save )); then
  omarchy-notification-send --image "$file" "Screenshot saved" "$file" >/dev/null 2>&1
else
  rm -f "$file"
  omarchy-notification-send "Screenshot copied" >/dev/null 2>&1
fi
