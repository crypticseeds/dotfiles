{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "'/home/ai/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Bash|apply_patch|.*create_pull_request)$",
        "hooks": [
          {
            "command": "/home/ai/.local/bin/agent-route check",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/home/ai/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/home/ai/.local/bin/agent-route session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/home/ai/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/home/ai/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
