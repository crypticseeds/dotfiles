{
  "_comment": [
    "Policy for templates/agent-guard/agent_guard.py. Edit by hand; generate.py --write-guard-policy",
    "rewrites it from its own lists (a convenience, not the source). Keys starting with _ are ignored.",
    "secret_globs: every path an argument of an unsandboxed tool may not resolve into (~ = home).",
    "repo_roots: where `git-in <dir>` may work (bin/git-in enforces the same).",
    "coderabbit_credits_until: last day (YYYY-MM-DD) `coderabbit --use-credits` is allowed, \"\" = never.",
    "excluded_commands: Claude's sandbox excludedCommands (`x *` = x and anything after, `x` = exactly x).",
    "hooks_paths: repo dir -> the repo-local core.hooksPath its .git/config may keep.",
    "explain_sandboxed_chains: true for Claude's own bwrap sandbox, where a chained excluded command",
    "runs sandboxed and fails; false under nono, where nothing is excluded. Only the claude harness",
    "uses it; opencode and omp calls never get these explanations."
  ],
  "secret_globs": [
    "~/.ssh/id_*",
    "~/.ssh/*.pem",
    "~/.gnupg/**",
    "~/.aws/credentials",
    "~/.aws/sso/**",
    "~/.aws/cli/cache/**",
    "~/.config/gcloud/**",
    "~/.azure/**",
    "~/.kube/**",
    "~/.docker/config.json",
    "~/.npmrc",
    "~/.pypirc",
    "~/.netrc",
    "~/.git-credentials",
    "~/.config/gh/hosts.yml",
    "~/.doppler/**",
    "~/.config/magpie/**",
    "~/.config/agentgateway/secrets/**",
    "~/.claude/.credentials.json",
    "~/.codex/auth*",
    "~/.local/share/opencode/auth.json",
    "~/.zsh_history",
    "~/.bash_history",
    "~/.local/share/keyrings/**",
    "~/.local/share/kwalletd/**",
    "~/.password-store/**",
    "~/.config/op/**",
    "~/.config/Bitwarden/**",
    "~/.pki/**",
    "~/.config/goa-1.0/**",
    "~/.mozilla/**",
    "~/.config/google-chrome/**",
    "~/.config/chromium/**",
    "~/.config/BraveSoftware/**",
    "~/.config/microsoft-edge/**",
    "~/.var/app/**",
    "~/snap/*/common/.mozilla/**",
    "~/.thunderbird/**",
    "~/.config/Signal/**",
    "~/.local/share/TelegramDesktop/**",
    "~/.local/share/fish/fish_history",
    "~/.python_history",
    "~/.psql_history",
    "~/.mysql_history",
    "/etc/rancher/**",
    "/var/lib/rancher/k3s/server/token",
    "/var/lib/rancher/k3s/server/node-token",
    "/var/lib/rancher/k3s/server/tls/**",
    "/etc/shadow",
    "/etc/gshadow",
    "/etc/sudoers",
    "/etc/sudoers.d/**",
    "/etc/ssh/ssh_host_*",
    "/etc/pki/tls/private/**",
    "/etc/ssl/private/**",
    "/etc/NetworkManager/system-connections/**",
    "/etc/wireguard/**",
    "/etc/kubernetes/admin.conf",
    "/etc/kubernetes/pki/**",
    "/var/lib/kubelet/**",
    "/mnt/hgfs/**",
    "/proc/*/environ",
    "/proc/*/cmdline",
    "/proc/*/mem",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.jks",
    "**/*.keystore",
    "**/*.ppk",
    "**/*.kdbx",
    "**/id_rsa",
    "**/id_ed25519",
    "**/.netrc",
    "**/.doppler.yaml",
    "**/*.tfstate",
    "**/*.tfstate.*",
    "**/.terraform/**",
    "**/*.tfplan",
    "**/tfplan",
    "**/.vault_pass*",
    "**/*vault-pass*",
    "**/*.vault",
    "**/vault.yml",
    "**/vault.yaml",
    "**/kubeconfig*",
    "**/*.kubeconfig"
  ],
  "repo_roots": [
    "~/REPOS"
  ],
  "coderabbit_credits_until": "",
  "excluded_commands": [
    "docker *",
    "podman *",
    "terraform *",
    "tofu *",
    "aws *",
    "doppler *",
    "git *",
    "gh *",
    "git-in *",
    "pre-commit *",
    "herdr *",
    "hc *",
    "kubectl *",
    "helm *",
    "agent-clean",
    "agent-clean *",
    "coderabbit review",
    "coderabbit review *",
    "opencode *",
    "omp *"
  ],
  "hooks_paths": {
    "~/REPOS/tfl-journey-expense-calculator": ".husky/_"
  },
  "explain_sandboxed_chains": true
}
