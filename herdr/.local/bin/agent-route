#!/usr/bin/env python3
"""agent-route: keep delegated agents and long or background jobs on the multiplexer that hosts the session,
pull requests stacked, and work in another worktree with that worktree's own worker.

One script for every harness hook, plugin and extension (Claude, Codex, opencode, omp). The host comes from
`agent-mux` (herdr-app, herdr or none); the rule text from `agent-mux --rules`; the redirect messages from
the HOSTS table below. Adding a host (rex) is one agent-mux branch, one rules function there and one HOSTS entry.
Every host also gets STACK_RULE: a plain `gh pr create` (or the GitHub MCP create_pull_request tool) is refused
in favour of `gh stack`. Under Herdr Core, `cd` into or editing files in another worktree is refused: that
worktree's work belongs to a visible hc worker; `git -C <worktree>` stays allowed for inspecting and committing.

  agent-route session-start     SessionStart hook (Claude, Codex): print the rules as additionalContext JSON
  agent-route rules             print the rules for this host (nothing for none), for plugins that inject text
  agent-route check [--neutral] PreToolUse routing check. Input (stdin JSON): a Claude/Codex payload
                                {tool_name, tool_input, cwd} or {"tool": ..., "input": {...}, "cwd": ...}.
                                Default output: Claude's PreToolUse deny JSON. --neutral: exit 0 = allow,
                                exit 2 and the reason on stdout = deny.

Not a security boundary: this is a workflow rule, so every failure (no agent-mux, no hc, a bad payload, an
unwritable cache) means "allow" and exit 0. It denies only when the host is verified, and never a command that
already goes through hc or herdr. The host is cached per terminal (agent-mux calls hc/herdr, which is slow):
a found host for an hour, `none` for five minutes when Herdr variables were set but detection failed.
"""
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

POSITIVE_TTL = 3600
NEGATIVE_TTL = 300

# Tools that start a delegated agent, per harness: Claude Agent (Task is its old name) and Workflow,
# opencode and omp `task`, Codex spawn_agent.
DELEGATION_TOOLS = {"agent", "task", "workflow", "spawn_agent"}
# Background flags of the shell tool: Claude run_in_background, opencode background, omp async.
BACKGROUND_KEYS = ("run_in_background", "background", "async")
BASH_TOOLS = {"bash", "shell"}
# File-editing tools: Claude Edit/Write/MultiEdit/NotebookEdit, opencode edit/write/patch, omp edit/write,
# Codex apply_patch.
EDIT_TOOLS = {"edit", "write", "multiedit", "notebookedit", "patch", "apply_patch"}
ENV_ASSIGN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
# Commands that run another command after their own arguments (`hc run ... -- gh pr create`).
WRAPPERS = {"hc", "herdr", "env", "command", "time", "nohup", "sudo", "doppler"}
SEGMENT = re.compile(r"&&|\|\||[;&|\n()`]|\$\(")
# Worktree roots: <repo>/.worktrees/<name>, <repo>/.claude/worktrees/<name>, ~/.herdr/worktrees/<repo>/<name>
WORKTREE = re.compile(r"^(.*?/(?:\.worktrees|\.claude/worktrees)/[^/]+|.*?/\.herdr/worktrees/[^/]+/[^/]+)(?:/|$)")
PATCH_FILE = re.compile(r"^\*\*\* (?:Add|Update|Delete) File: (.+)$", re.M)

STACK_RULE = (
    "Pull requests are always stacked with GitHub's native stacks (`gh stack`, see the gh-stack skill), even a "
    "single PR: `gh stack init <branch>` (adopts an existing branch), `gh stack add <next-branch>` for each further "
    "layer, `gh stack submit --auto --open` to push and open the PRs, `gh stack sync` to stay current. A plain "
    "`gh pr create` and the GitHub MCP create_pull_request tool are refused. Independent tasks get their own stack; "
    "dependent steps are layers of one stack. Merge (`gh stack merge`) only when the user asks. If gh stack exits 9 "
    "(stacks not enabled on the repository), stop and tell the user.")


def _hc_job(cwd, command):
    cmd = "<command>"
    if command and len(command) <= 300:
        cmd = "sh -c " + shlex.quote(command)
    return ("hc run --bg --name <slug> --cwd %s -- %s. Then hc wait <slug> and hc read --lines 80 <slug>"
            % (shlex.quote(cwd or "<dir>"), cmd))


def _hc_agent(cwd):
    return ("hc run --bg --name <slug> --cwd %s <template-or-agent> \"<task>\" (check hc templates first, "
            "explicit model, interactive launch). Then hc wait <slug> and hc read --lines 80 <slug>"
            % shlex.quote(cwd or "<dir>"))


def _herdr_job(cwd, command):
    cmd = "'<command>'"
    if command and len(command) <= 300:
        cmd = shlex.quote(command)
    return ("herdr pane run <pane> %s in a pane you created for it (cwd %s, never the main tab, max 2x2 panes "
            "per tab). Then herdr pane read <pane>" % (cmd, cwd or "<dir>"))


def _herdr_agent(cwd):
    return ("herdr agent start <name> --kind <claude|opencode|omp> --pane <pane> -- <native args>, then "
            "herdr agent prompt <name> '<task>' (pane placement per the delegate-visibly skill, never the main "
            "tab, max 2x2 panes per tab, cwd %s). Then herdr agent wait <name>" % (cwd or "<dir>"))


# One entry per host: how to say "run it as a child" for a job and for an agent, and where the details are.
HOSTS = {
    "herdr-app": {"label": "Herdr Core (herdr-app)", "job": _hc_job, "agent": _hc_agent,
                  "see": "Load the herdr-app skill and run hc --skill."},
    "herdr": {"label": "the Herdr terminal UI (herdr)", "job": _herdr_job, "agent": _herdr_agent,
              "see": "Load the delegate-visibly skill (and the herdr skill for CLI syntax)."},
}


def here():
    return os.path.dirname(os.path.abspath(__file__))


def agent_mux():
    for cand in (os.path.join(here(), "agent-mux"), shutil.which("agent-mux")):
        if cand and os.access(cand, os.R_OK):
            return cand
    return None


def run_mux(*args):
    mux = agent_mux()
    if not mux:
        return ""
    try:
        # sh, not exec: under nono the stowed script resolves into ~/dotfiles, which has no execute right
        out = subprocess.run(["sh", mux, *args], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout if out.returncode == 0 else ""


def cache_file():
    key = "|".join(os.environ.get(k, "") for k in ("HC_TERMINAL_ID", "HERDR_ENV", "HERDR_PANE_ID", "HERDR_SOCKET_PATH"))
    base = os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR") or "/tmp"
    return os.path.join(base, "agent-route-%d" % os.getuid(), hashlib.sha1(key.encode()).hexdigest())


def host():
    """herdr-app, herdr or none. Cached per terminal; any failure is none."""
    if not (os.environ.get("HC_TERMINAL_ID") or os.environ.get("HERDR_ENV") == "1"):
        return "none"  # no Herdr variable at all: nothing to detect, nothing to cache
    path = cache_file()
    try:
        with open(path) as f:
            name, stamp = f.read().split()
        if name in HOSTS and time.time() - float(stamp) < POSITIVE_TTL:
            return name
        if name == "none" and time.time() - float(stamp) < NEGATIVE_TTL:
            return name
    except (OSError, ValueError):
        pass
    name = run_mux().strip()
    if name not in HOSTS:
        name = "none"
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        with open(path, "w") as f:
            f.write("%s %f\n" % (name, time.time()))
    except OSError:
        pass
    return name


def rules():
    name = host()
    text = run_mux("--rules", name).strip() if name != "none" else ""
    return (text + "\n\n" + STACK_RULE).strip()


def goes_through_multiplexer(command):
    """True when the command's first word is hc or herdr (after VAR=value prefixes)."""
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    for w in words:
        if ENV_ASSIGN.match(w):
            continue
        return os.path.basename(w) in ("hc", "herdr")
    return False


def route(tool, tool_input, cwd, name):
    """The redirect message for a call that must go through the multiplexer, or None to allow it."""
    if name not in HOSTS:
        return None
    tool = (tool or "").lower()
    entry, where = HOSTS[name], cwd or os.getcwd()
    if tool in DELEGATION_TOOLS:
        what, how = "the %s tool (a delegated agent)" % tool, entry["agent"](where)
    elif tool in BASH_TOOLS and any(tool_input.get(k) is True for k in BACKGROUND_KEYS):
        command = str(tool_input.get("command") or "")
        if goes_through_multiplexer(command):
            return None
        what, how = "a background shell command", entry["job"](where, command)
    else:
        return None
    return ("%s hosts this session, so %s may not run through your harness. Run it as a visible child instead: %s. "
            "Delegated agents and long or background jobs always go through the multiplexer; quick foreground "
            "commands stay normal. %s" % (entry["label"][0].upper() + entry["label"][1:], what, how, entry["see"]))


def segments(command):
    """The command's simple commands as word lists (split on ; && || | & newlines and subshells)."""
    for seg in SEGMENT.split(command or ""):
        try:
            words = shlex.split(seg)
        except ValueError:
            words = seg.split()
        while words and ENV_ASSIGN.match(words[0]):
            words = words[1:]
        if words:
            yield words


def runs_pr_create(command):
    """True when a simple command runs `gh ... pr create`, directly or after a wrapper (`hc run ... -- gh ...`)."""
    for words in segments(command):
        starts = [0]
        if os.path.basename(words[0]) in WRAPPERS:
            starts = [i + 1 for i, w in enumerate(words) if w == "--"] or [i for i, w in enumerate(words) if w == "gh"]
        for i in starts:
            if i >= len(words) or os.path.basename(words[i]) != "gh":
                continue
            rest, skip = [], False
            for w in words[i + 1:]:
                if skip:
                    skip = False
                elif w in ("-R", "--repo", "--hostname"):  # gh flags that take a separate value
                    skip = True
                elif not w.startswith("-"):
                    rest.append(w)
            if rest[:2] == ["pr", "create"]:
                return True
    return False


def stack_reason(tool, tool_input):
    """The redirect message for a plain PR creation, on every host, or None."""
    if "create_pull_request" in tool:
        what = "the %s tool" % tool
    elif tool in BASH_TOOLS and runs_pr_create(str(tool_input.get("command") or "")):
        what = "`gh pr create`"
    else:
        return None
    return ("Pull requests are always stacked here, so %s is refused. Use GitHub's native stacks (gh-stack skill), "
            "even for a single PR: `gh stack init <current-branch>` (adopts the branch with its commits), then "
            "`gh stack submit --auto --open`; edit the generated title or body afterwards with `gh pr edit`. Add more "
            "layers with `gh stack add <next-branch>`. If gh stack exits 9, stacks are not enabled on this repository: "
            "stop and tell the user." % what)


def worktree_root(path, cwd):
    """The worktree root that path lies in (resolved against cwd, ~ expanded), or None for no worktree."""
    if not path:
        return None
    full = os.path.normpath(os.path.join(cwd or os.getcwd(), os.path.expanduser(path)))
    m = WORKTREE.match(full)
    return m.group(1) if m else None


def edit_targets(tool, tool_input):
    """The paths a file-editing call writes to."""
    paths = [tool_input.get(k) for k in ("file_path", "filePath", "path", "notebook_path")]
    if tool in ("apply_patch", "patch"):
        text = " ".join(str(tool_input.get(k) or "") for k in ("command", "patch", "input", "patchText"))
        paths += PATCH_FILE.findall(text)
    return [p for p in paths if isinstance(p, str) and p]


def cd_targets(command):
    """The directories a shell command changes into (cd / pushd)."""
    return [words[1] for words in segments(command) if words[0] in ("cd", "pushd") and len(words) > 1]


def worktree_reason(tool, tool_input, cwd):
    """Under Herdr Core: the redirect message for working in another worktree, or None."""
    if tool in EDIT_TOOLS:
        targets, what = edit_targets(tool, tool_input), "editing files"
    elif tool in BASH_TOOLS:
        targets, what = cd_targets(str(tool_input.get("command") or "")), "changing into it"
    else:
        return None
    mine = worktree_root(cwd, cwd)
    for target in targets:
        root = worktree_root(target, cwd)
        if root and root != mine:
            return ("%s is another worktree, so %s here is refused: its work belongs to a visible worker. Start one "
                    "with hc run --bg --name <slug> --cwd %s agent-launch --subagent <harness> -- <native args> "
                    "(explicit model; run agent-worktree-setup %s first for a new worktree). You may still inspect and "
                    "verify with git -C %s (status, diff, log) and commit verified work there."
                    % (root, what, shlex.quote(root), shlex.quote(root), shlex.quote(root)))
    return None


def read_payload():
    data = json.load(sys.stdin)
    if not isinstance(data, dict):
        raise ValueError("not an object")
    if "tool_name" in data:  # Claude and Codex
        return data.get("tool_name"), data.get("tool_input") or {}, data.get("cwd")
    return data.get("tool"), data.get("input") or {}, data.get("cwd")


def cmd_check(neutral):
    try:
        tool, tool_input, cwd = read_payload()
        if not isinstance(tool_input, dict) or not isinstance(tool, str):
            return 0
        t = tool.lower()
        reason = stack_reason(t, tool_input)  # every host, no host detection needed
        if not reason and t in DELEGATION_TOOLS | BASH_TOOLS | EDIT_TOOLS:
            name = host()
            if t in BASH_TOOLS and any(tool_input.get(k) is True for k in BACKGROUND_KEYS) or t in DELEGATION_TOOLS:
                reason = route(tool, tool_input, cwd, name)
            if not reason and name == "herdr-app":
                reason = worktree_reason(t, tool_input, cwd)
    except Exception:
        return 0
    if not reason:
        return 0
    if neutral:
        print(reason)
        return 2
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    return 0


def cmd_session_start():
    try:
        text = rules()
    except Exception:
        return 0
    if text:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}))
    return 0


def main(argv):
    if argv[:1] == ["check"]:
        return cmd_check("--neutral" in argv)
    if argv[:1] == ["session-start"]:
        return cmd_session_start()
    if argv[:1] == ["rules"]:
        try:
            text = rules()
        except Exception:
            return 0
        if text:
            print(text)
        return 0
    print("usage: agent-route session-start | rules | check [--neutral]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
