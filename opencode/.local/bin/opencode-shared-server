#!/bin/sh
# opencode v2's shared background server, run by systemd (opencode.service) instead of by whichever
# client happens to start it first. The server resolves MCPHub auth from its own environment and
# spawns the local MCP servers, so it needs MCPHUB_DEFAULT_KEY, the tool PATH (set by the
# unit) and the machine-local config overlay. Clients find the one server via its service file.
set -e
overlay="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.local.json"
if [ -f "$overlay" ]; then
  export OPENCODE_CONFIG="$overlay"
fi
# A client starts its own server whenever none is running, e.g. after
# `opencode service restart` stops this one. Stop it so the service file points back at us.
opencode service stop >/dev/null 2>&1 || true
if [ -n "$MCPHUB_DEFAULT_KEY" ]; then
  exec opencode serve --service
fi
exec doppler run -p harness -c dev_maghub --only-secrets MCPHUB_DEFAULT_KEY -- opencode serve --service
