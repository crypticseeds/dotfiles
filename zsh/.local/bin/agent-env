#!/usr/bin/env bash
# Start an AI harness with the harness/dev_maghub Doppler environment, from any
# directory.
#
# The flags override directory defaults. A service token can override the flags,
# so check the fetched payload's reserved scope metadata before injecting it.
#
# Callers: the harness aliases in zsh/.config/zsh/aliases.zsh (claude, cc, oc,
# opencode, omp, codex) and the hc / rex wrappers for non-interactive launches.
# See docs/doppler-agent-env.md.
set -euo pipefail

project=harness
config=dev_maghub
selected=''
if [[ ${1:-} == --scope ]]; then
  if [[ $# -lt 6 || $5 != -- || -z $4 ]]; then
    echo 'usage: agent-env --scope PROJECT CONFIG SECRET_NAMES -- COMMAND [ARGS...]' >&2
    exit 2
  fi
  project=$2 config=$3 selected=$4
  shift 5
fi

if [ $# -eq 0 ]; then
  echo "usage: agent-env <command> [args...]" >&2
  exit 2
fi

mount_dir=$(mktemp -d)
trap 'rm -f -- "$mount_dir/secrets.json"; rmdir -- "$mount_dir"' EXIT

# Mount through a FIFO so an unexpected payload cannot affect the verifier's
# environment, including interpreter or dynamic loader settings.
doppler run -p "$project" -c "$config" --mount "$mount_dir/secrets.json" --mount-max-reads 1 -- \
  /usr/bin/python3 -I -S -c '
import json
import os
import sys
import uuid

payload_path, project, config, selected, *command = sys.argv[1:]

# MCPHub (isolated mode) keys browser state (Playwright, Chrome DevTools) to the X-MCPHub-State-Id header,
# which the MCP configs fill from this variable. Fresh per launch, also for a worker started by another
# agent, so no two agents share a browser session. Per-process, so never a Doppler value.
os.environ["MCPHUB_STATE_ID"] = str(uuid.uuid4())
with open(payload_path, encoding="utf-8") as payload:
    secrets = json.load(payload)

if (secrets.get("DOPPLER_PROJECT"), secrets.get("DOPPLER_CONFIG")) != (project, config):
    sys.exit(f"agent-env: expected Doppler scope {project}/{config}; refusing to launch")

if os.path.basename(command[0]) == "codex":
    args = command[1:]
    if "--" in args:
        args = args[:args.index("--")]
    remote = any(arg == "--remote" or arg.startswith("--remote=") for arg in args)
    if remote and selected:
        print("agent-env: scoped Codex launches require a local executor", file=sys.stderr)
        sys.exit(2)
    if not remote and "--no-daemon" not in args:
        command.insert(1, "--no-daemon")

if selected:
    # The bootstrap can use its normal login. The worker starts with only
    # terminal/runtime settings and explicitly selected values from the payload.
    runtime = ("HOME", "USER", "LOGNAME", "SHELL", "PATH", "TERM", "COLORTERM", "LANG", "LC_ALL",
               "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "XDG_RUNTIME_DIR",
               "HC_TERMINAL_ID", "MCPHUB_STATE_ID")
    environment = {name: os.environ[name] for name in runtime if name in os.environ}
    for name in selected.split(","):
        # NAME? = optional: skipped when the config does not have it (e.g. the agent Modal token)
        optional = name.endswith("?")
        name = name.rstrip("?")
        if optional and name not in secrets:
            continue
        if not name.isascii() or not name.isidentifier() or name != name.upper() or name in runtime or name.startswith(("DOPPLER_", "LD_", "DYLD_", "NONO_", "PYTHON", "NODE_", "BASH_", "GIT_", "XDG_")) or name in ("ENV", "BASH_ENV", "IFS", "SSH_AUTH_SOCK", "GH_TOKEN", "GITHUB_TOKEN"):
            sys.exit(f"agent-env: disallowed worker environment name: {name}")
        if name not in secrets:
            sys.exit(f"agent-env: selected Doppler variable is missing: {name}")
        environment[name] = secrets[name]
    os.execvpe(command[0], command, environment)

os.environ.pop("DOPPLER_CLI_SECRETS_PATH", None)
gateway = ("ANTHROPIC_API_KEY", "ANTHROPIC_BASE_URL", "OPENAI_API_KEY", "OPENAI_BASE_URL")
# Claude uses its own login by default (as in agent-launch): no gateway variables, injected or inherited.
# For Claude on the gateway use: agent-launch -g claude
own = os.path.basename(command[0]) == "claude"
if own:
    for name in gateway + ("ANTHROPIC_AUTH_TOKEN",):
        os.environ.pop(name, None)
# MODAL_TOKEN_*: the agents own revocable Modal service-user token, so sandboxed `modal` never needs the
# owners ~/.modal.toml (which the sandbox hides). Injected only when the config has it.
for name in (() if own else gateway) + ("MCPHUB_DEFAULT_KEY", "MODAL_TOKEN_ID", "MODAL_TOKEN_SECRET"):
    if name in secrets:
        os.environ[name] = secrets[name]
os.execvp(command[0], command)
' "$mount_dir/secrets.json" "$project" "$config" "$selected" "$@"
