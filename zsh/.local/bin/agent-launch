#!/usr/bin/env bash
set -euo pipefail

project=harness
config=dev_maghub
# Default auth per harness: `own` = the harness's own login (no Anthropic gateway variables),
# `gateway` = the Doppler LLM gateway. -o / -g override it for one launch.
declare -A auth_default=([claude]=own [omp]=gateway [opencode]=gateway [codex]=gateway [antigravity]=gateway)
gateway_names=ANTHROPIC_API_KEY,ANTHROPIC_BASE_URL,OPENAI_API_KEY,OPENAI_BASE_URL
common_names=MCPHUB_DEFAULT_KEY
auth=
standalone=false
extra_names=()
worker=false
write_dirs=()
permissions=()
usage() {
  cat >&2 <<'EOF'
usage: agent-launch [options] HARNESS [--] [ARGS...]
  HARNESS                 claude | omp | opencode | codex | agy
  -o, --own               use the harness's own login (no gateway variables: ANTHROPIC_*, OPENAI_*)
  -g, --gateway           use the Doppler LLM gateway (ANTHROPIC_* and OPENAI_* keys)
                          default: claude=own, others=gateway
  -s, --standalone        opencode only: private server inside the sandbox (tools sandboxed)
  --doppler PROJECT/CONFIG  take the variables from this Doppler config
  --secret NAME           also pass this variable from the config (repeatable)
  --read DIR | --allow DIR  grant DIR read-only | read-write
  --subagent              worker mode: read-only git metadata, read-only extra grants
EOF
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --subagent) worker=true; shift ;;
    -o|--own|-g|--gateway)
      new=own; if [[ $1 == -g || $1 == --gateway ]]; then new=gateway; fi
      if [[ -n $auth && $auth != "$new" ]]; then echo 'agent-launch: use -o or -g, not both' >&2; exit 2; fi
      auth=$new; shift ;;
    -s|--standalone) standalone=true; shift ;;
    --doppler|--secret|--read|--allow)
      if [[ $# -lt 2 || $2 == -* || -z $2 ]]; then usage; exit 2; fi
      case "$1" in
        --doppler)
          if [[ ! $2 =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$ ]]; then usage; exit 2; fi
          project=${2%/*} config=${2#*/} ;;
        --secret)
          if [[ ! $2 =~ ^[A-Z_][A-Z0-9_]*$ ]]; then usage; exit 2; fi
          extra_names+=("$2") ;;
        --read|--allow)
          dir=$(realpath -e -- "$2")
          if [[ ! -d $dir || $dir == / || $dir == "$HOME" ]]; then usage; exit 2; fi
          permissions+=("$1" "$dir")
          if [[ $1 == --allow ]]; then write_dirs+=("$dir"); fi ;;
      esac
      shift 2 ;;
    -*) printf 'agent-launch: unknown option: %s\n' "$1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done

native=()
case "${1:-}" in
  claude) profile=claude; binary=$HOME/.local/bin/claude; native=(--permission-mode auto) ;;
  omp) profile=omp; binary=$HOME/.bun/bin/omp; native=(--approval-mode=yolo) ;;
  opencode) profile=opencode; binary=$HOME/.opencode/bin/opencode; native=(--auto) ;;
  codex) profile=codex; binary=$HOME/.local/bin/codex; native=(--no-daemon --ask-for-approval never) ;;
  agy|antigravity) profile=antigravity; binary=$(command -v agy) ;;
  *) usage; exit 2 ;;
esac
shift
auth=${auth:-${auth_default[$profile]}}
names=$common_names
if [[ $auth == gateway ]]; then names=$gateway_names,$names; fi
if $standalone && [[ $profile != opencode ]]; then
  echo 'agent-launch: -s/--standalone is for opencode only' >&2; exit 2
fi
if [[ ${1:-} == -- ]]; then shift; fi
if [[ $profile == codex ]]; then
  for arg in "$@"; do
    [[ $arg == -- ]] && break
    if [[ $arg == --remote || $arg == --remote=* ]]; then
      echo 'agent-launch: scoped Codex launches require a local executor' >&2
      exit 2
    fi
  done
fi
dry_run=${AGENT_LAUNCH_DRY_RUN:-}
if [[ ! -x $binary ]]; then
  printf 'agent-launch: executable unavailable: %s\n' "$binary" >&2
  if [[ -z $dry_run ]]; then exit 1; fi
fi
# Every harness's routing hook reads agent-route and agent-mux, stow symlinks into the dotfiles repo.
if route_target=$(realpath -e -- "$HOME/.local/bin/agent-route" 2>/dev/null); then
  permissions+=(--read "${route_target%/*}")
fi
if [[ $profile == claude && -f /etc/claude-code/managed-settings.json ]]; then
  permissions+=(--read-file /etc/claude-code/managed-settings.json)
fi
# The guard hook (claude, opencode, omp) fails closed without its root-owned policy.
if [[ -f /etc/agent-guard/policy.json ]]; then
  permissions+=(--read-file /etc/agent-guard/policy.json)
fi
# gh's own config dir (pi-agent-host sets GH_CONFIG_DIR; ~/.config/gh holds a login and stays denied).
(umask 077; mkdir -p -- "$HOME/.local/state/agent-gh")
# GitHub PAT via nono's credential proxy (routes in pi-agent-host.json). Turned on here, not in the
# profile: a harness pack's own network.credentials list replaces the inherited one.
permissions+=(--credential gh_api --credential gh_git)
if $worker; then
  # Workers read GitHub, never write it: REST GETs, and git fetch (info/refs GET, upload-pack POST).
  # Push (git-receive-pack POST), GraphQL and every other write are refused by the proxy.
  permissions+=(--allow-endpoint 'gh_api:GET:/**' --allow-endpoint 'gh_git:GET:/**'
    --allow-endpoint 'gh_git:POST:/*/*/git-upload-pack')
fi
# opencode's root-owned managed config: unreadable, opencode silently drops its permission layer.
if [[ $profile == opencode && -f /etc/opencode/opencode.json ]]; then
  permissions+=(--read-file /etc/opencode/opencode.json)
fi
# Global instructions, skills and subagents (~/.agents, CLAUDE.md, ~/.claude/{skills,agents}) are stow
# symlinks into the dotfiles repo, unreadable from any other workspace without this grant.
if agents_target=$(realpath -e -- "$HOME/.agents" 2>/dev/null) && [[ $agents_target != "$HOME/.agents" ]]; then
  permissions+=(--read "$agents_target")
fi
if [[ $profile == claude ]]; then
  # Claude's Bash sandbox needs its own write grant, inside nono's grant.
  if [[ ${#write_dirs[@]} -ne 0 ]]; then native=(--add-dir "${write_dirs[@]}" "${native[@]}"); fi
  claude_socket_dir="$HOME/.claude/tmp/claude-$(id -u)"
  (umask 077; mkdir -p -- "$claude_socket_dir")
  permissions+=(--allow-unix-socket-dir-bind "$claude_socket_dir")
  # The status line script and settings are stow symlinks that resolve outside the workspace.
  for claude_file in statusline-command.sh settings.json; do
    if claude_target=$(realpath -e -- "$HOME/.claude/$claude_file" 2>/dev/null); then
      permissions+=(--read-file "$claude_target")
    fi
  done
fi
if [[ $profile == opencode ]]; then
  config_target=$(realpath -e -- "$HOME/.config/opencode/opencode.jsonc")
  permissions+=(--read "${config_target%/*}")
  pty_dir="/tmp/opencode-pty-$(id -u)"
  if [[ ! -d $pty_dir ]]; then mkdir -m 700 -- "$pty_dir"; fi
  permissions+=(--allow-unix-socket-dir-bind "$pty_dir")
  moshi_socket="${XDG_RUNTIME_DIR:-/tmp}/moshi-hook.sock"
  if [[ -S $moshi_socket ]]; then permissions+=(--allow-unix-socket "$moshi_socket"); fi
  if [[ ${1:-} == run ]]; then
    native=()
    shift
    set -- run --auto "$@"
  fi
  if $standalone; then
    if [[ ${1:-} == run ]]; then shift; set -- run --standalone "$@"; else native+=(--standalone); fi
  else
    echo 'agent-launch: opencode tools run in the shared server, outside the sandbox; use -s to sandbox them' >&2
  fi
fi

in_worktree=true
if ! workspace=$(LC_ALL=C /usr/bin/git rev-parse --show-toplevel 2>&1); then
  case "$workspace" in
    'fatal: not a git repository (or any of the parent directories): .git'*|\
    'fatal: not a git repository (or any parent up to mount point '*)
      workspace=$(pwd -P)
      in_worktree=false ;;
    *) printf 'agent-launch: %s\n' "$workspace" >&2; exit 1 ;;
  esac
fi
if [[ $workspace == / || $workspace == "$HOME" ]]; then
  echo 'agent-launch: choose a workspace below your home or filesystem root' >&2
  exit 2
fi
cd -- "$workspace"
if $worker && [[ ${#write_dirs[@]} -ne 0 ]]; then
  echo 'agent-launch: subagents only accept extra read grants' >&2
  exit 2
fi
outer=(/usr/bin/bwrap --unshare-user --disable-userns --bind / / --dev-bind /dev /dev)
# Other harnesses' config dirs, read-only: some packs grant them read-write (opencode: ~/.claude and
# ~/.codex), which would let one agent edit another's settings, hooks or plugin bin dirs on PATH.
declare -A config_dirs=([claude]="$HOME/.claude" [codex]="$HOME/.codex")
for owner in "${!config_dirs[@]}"; do
  if [[ $owner != "$profile" && -d ${config_dirs[$owner]} ]]; then
    outer+=(--ro-bind "${config_dirs[$owner]}" "${config_dirs[$owner]}")
  fi
done
# Other harnesses' stored logins. nono cannot deny them (each harness pack grants its whole state
# dir, and Landlock refuses a deny inside a grant), so blank them here. The launched harness keeps its own.
declare -A auth_files=([claude]="$HOME/.claude/.credentials.json" [codex]="$HOME/.codex/auth.json"
  [opencode]="$HOME/.local/share/opencode/auth.json")
for owner in "${!auth_files[@]}"; do
  if [[ $owner != "$profile" && -f ${auth_files[$owner]} ]]; then
    outer+=(--ro-bind /dev/null "${auth_files[$owner]}")
  fi
done
if $in_worktree; then
  git_paths=$(/usr/bin/git rev-parse --path-format=absolute --git-dir --git-common-dir)
  git_dir=${git_paths%%$'\n'*}
  common_dir=${git_paths#*$'\n'}
  if $worker; then
    outer+=(--ro-bind "$common_dir" "$common_dir")
    if [[ $git_dir != "$common_dir" ]]; then outer+=(--ro-bind "$git_dir" "$git_dir"); fi
    if [[ -f $workspace/.git ]]; then outer+=(--ro-bind "$workspace/.git" "$workspace/.git"); fi
    permissions+=(--read "$common_dir" --read "$git_dir")
  else
    # Hooks and config take effect outside the sandbox later (git hooks, core.* settings).
    if [[ -d $common_dir/hooks ]]; then outer+=(--ro-bind "$common_dir/hooks" "$common_dir/hooks"); fi
    if [[ -f $common_dir/config ]]; then outer+=(--ro-bind "$common_dir/config" "$common_dir/config"); fi
  fi
  # The effective hooks dir when core.hooksPath moves it (relative: to the worktree root; /dev/null = none).
  hooks_path=$(/usr/bin/git config --type=path --get core.hooksPath || true)
  if [[ -n $hooks_path && $hooks_path != /dev/null ]]; then
    if [[ $hooks_path != /* ]]; then hooks_path=$workspace/$hooks_path; fi
    if [[ -d $hooks_path ]]; then outer+=(--ro-bind "$hooks_path" "$hooks_path"); fi
  fi
  # Per-worktree config (extensions.worktreeConfig) sets core.* settings too.
  for worktree_config in "$git_dir/config.worktree" "$common_dir/config.worktree"; do
    if [[ -f $worktree_config ]]; then outer+=(--ro-bind "$worktree_config" "$worktree_config"); fi
    if [[ $git_dir == "$common_dir" ]]; then break; fi
  done
  # Agent config that would loosen the next session. All of .claude read-only, except .claude/worktrees
  # (where worktrees live). The mount point must exist, so create it first.
  if [[ -d $workspace/.claude ]]; then
    mkdir -p -- "$workspace/.claude/worktrees"
    outer+=(--ro-bind "$workspace/.claude" "$workspace/.claude"
      --bind "$workspace/.claude/worktrees" "$workspace/.claude/worktrees")
  fi
  # Root entries are bound one by one only when they exist; agent_guard.py denies shell writes that would
  # create the missing ones (accident-level).
  for protected in .mcp.json opencode.json .omp .envrc; do
    if [[ -e $workspace/$protected ]]; then outer+=(--ro-bind "$workspace/$protected" "$workspace/$protected"); fi
  done
fi
# Dotenv files are masked in every workspace, Git or not. find, not git ls-files: it also sees untracked
# and ignored files, and pruning .git and node_modules keeps the walk cheap. Files and symlinks: bwrap
# binds onto the resolved target, so a symlink masks the file it points to (even outside the workspace);
# a dangling one is skipped. A file created later is not masked.
mask_files=()
while IFS= read -r -d '' mask_file; do
  if [[ -e $mask_file ]]; then mask_files+=("$mask_file"); fi
done < <(find "$workspace" \( -name .git -o -name node_modules \) -prune -o \
  \( -type f -o -type l \) \( -name .env -o -name '.env.*' \) ! -name .env.example ! -name .env.example.bak -print0)
for mask_file in "${mask_files[@]}"; do outer+=(--ro-bind /dev/null "$mask_file"); done
outer+=(--)
for name in "${extra_names[@]}"; do names+=",$name"; done
cmd=("$HOME/.local/bin/agent-env" --scope "$project" "$config" "$names" --
  "${outer[@]}" "$HOME/.local/bin/nono" run --profile "nolabs-ai/$profile" --extends pi-agent-host
  --workdir "$workspace" --allow-cwd "${permissions[@]}" -- "$binary" "${native[@]}" "$@")
if [[ -n $dry_run ]]; then
  # Print the final argv, one argument per line; skip profile validation and exec.
  printf '%s\n' "${cmd[@]}"
  exit 0
fi
"$HOME/.local/bin/nono" profile validate "nolabs-ai/$profile" >/dev/null
exec "${cmd[@]}"
