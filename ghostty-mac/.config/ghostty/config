# Ghostty on macOS. The Linux/niri config lives in the ghostty/ package;
# both deploy to ~/.config/ghostty/config, so stow only one per machine.
# Run `ghostty +show-config --default --docs` for every option.

working-directory = ~/MEGA

# Gruvbox Hard colors on black, copied from the Linux noctalia theme
# (~/.config/ghostty/themes/noctalia, generated from Noctalia's "Gruvbox Hard").
background = #000000
foreground = #d4be98
cursor-color = #d4be98
cursor-text = #000000
selection-background = #3c3836
selection-foreground = #ddc7a1
palette = 0=#3c3836
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#7c6f64
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#ddc7a1

# Drop the folder icon from the title bar; the default transparent style
# keeps the red/yellow/green buttons and native window tiling.
macos-titlebar-proxy-icon = hidden
# Blank title text (also blanks the window name in Mission Control / AeroSpace).
title = " "

font-family = JetBrainsMono Nerd Font
font-size = 18
cursor-style = underline
mouse-hide-while-typing = true
copy-on-select = true
selection-clear-on-copy = true
# Treat Left Option as Alt so Option+Backspace/arrows reach the shell as word
# commands (the ABC layout defaults this to false). Right Option still types
# characters: the Corne sends Right Option+3 for the pound sign.
macos-option-as-alt = left

# Shell integration's "cursor" feature forces a bar cursor at the prompt,
# overriding cursor-style. Disable it so the underline sticks.
shell-integration-features = no-cursor

# Splits, tabs and spaces are handled by herdr (cmd keys in its config.toml).
# Unbind them here so Ghostty passes the keys through instead of acting on them.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+w=unbind
keybind = cmd+t=unbind
keybind = cmd+shift+t=unbind
keybind = cmd+shift+w=unbind
keybind = cmd+n=unbind
keybind = cmd+shift+z=unbind
